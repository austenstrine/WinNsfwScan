{
  "manifest_version": 3,
  "name": "WinNsfwScan Browser Guard",
  "description": "Scans the visible browser tab for objectionable content and goes back once when detected.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Guard",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
