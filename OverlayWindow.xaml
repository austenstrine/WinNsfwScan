<Window
	x:Class="WinNsfwScan.OverlayWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	WindowStyle="None"
	ResizeMode="NoResize"
	WindowState="Maximized"
	Topmost="True"
	ShowInTaskbar="False"
	Background="#161616"
	MouseLeftButtonDown="OverlayRoot_MouseLeftButtonDown"
	Title="Content Blocked"
>
	<Grid MouseLeftButtonDown="OverlayRoot_MouseLeftButtonDown">
		<Border
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="#2E2E2E"
			Padding="36,28"
			CornerRadius="10"
		>
			<StackPanel>
				<TextBlock
					Text="NSFW content detected"
					Foreground="#F3F4F6"
					FontSize="34"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
				/>
				<TextBlock
					Text="Click anywhere to dismiss"
					Foreground="#D1D5DB"
					FontSize="18"
					Margin="0,10,0,0"
					HorizontalAlignment="Center"
				/>
			</StackPanel>
		</Border>
	</Grid>
</Window>