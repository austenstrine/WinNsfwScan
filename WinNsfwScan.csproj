<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<BackendExecutable Condition="'$(OS)' == 'Windows_NT'">server.exe</BackendExecutable>
		<BackendExecutable Condition="'$(OS)' != 'Windows_NT'">server</BackendExecutable>

		<VenvPython Condition="'$(OS)' == 'Windows_NT'">$(ProjectDir)venv\Scripts\python.exe</VenvPython>
		<VenvPython Condition="'$(OS)' != 'Windows_NT'">$(ProjectDir)venv/bin/python</VenvPython>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="backend.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<Target Name="GenerateBackendConfig" BeforeTargets="Build">
		<Exec 
			Command="&quot;$(VenvPython)&quot; -m PyInstaller --onefile --add-data &quot;320n.onnx:nudenet&quot; --name server --distpath $(ProjectDir) --workpath $(ProjectDir)build --specpath $(ProjectDir) server.py"
			WorkingDirectory="$(ProjectDir)" 
		/>

		<WriteLinesToFile 
			File="$(ProjectDir)backend.json"
			Lines="{ &quot;ServerExecutable&quot;: &quot;$(BackendExecutable)&quot; }"
			Overwrite="true" 
		/>

		<Message Text="Generated backend.json with $(BackendExecutable)" Importance="high" />
	</Target>

</Project>