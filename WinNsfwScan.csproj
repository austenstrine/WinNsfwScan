<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<CsWinRTWindowsMetadata>10.0.19041.0</CsWinRTWindowsMetadata>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<PropertyGroup>
		<BackendExecutable Condition="'$(OS)' == 'Windows_NT'">server.exe</BackendExecutable>
		<BackendExecutable Condition="'$(OS)' != 'Windows_NT'">server</BackendExecutable>
		<BackendProjectDir>$(ProjectDir)server</BackendProjectDir>
		<NnBackendExecutable Condition="'$(OS)' == 'Windows_NT'">server.exe</NnBackendExecutable>
		<NnBackendExecutable Condition="'$(OS)' != 'Windows_NT'">server</NnBackendExecutable>
		<NnBackendProjectDir>$(ProjectDir)nn-server</NnBackendProjectDir>

		<VenvPython Condition="'$(OS)' == 'Windows_NT'">$(ProjectDir)venv\Scripts\python.exe</VenvPython>
		<VenvPython Condition="'$(OS)' != 'Windows_NT'">$(ProjectDir)venv/bin/python</VenvPython>
	</PropertyGroup>

	<!-- ===================================================== -->
	<!--  Automatically build frontend on every dotnet build   -->
	<!-- ===================================================== -->
	<Target Name="BuildFrontend" BeforeTargets="Build">
		<Message Text="=== Building frontend (Vite) ===" Importance="high" />

		<Exec Command="npm run build" WorkingDirectory="$(ProjectDir)frontend" ContinueOnError="false" />

		<!-- Wipe stale webui output then copy fresh dist -->
		<RemoveDir Directories="$(OutputPath)webui" />

		<ItemGroup>
			<FrontendFiles Include="$(ProjectDir)frontend\dist\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(OutputPath)webui\%(RecursiveDir)" />

		<Message Text="=== Frontend built and copied to webui/ ===" Importance="high" />
	</Target>

	<ItemGroup>
		<!-- WebView2 -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />

    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
		<PackageReference Include="Vortice.DXGI" Version="3.6.2" />
		<PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="NsfwSharp\NsfwSharp\NsfwSharp.csproj" />
		<!-- Exclude NsfwSharp subdirectory from WinNsfwScan's implicit compile glob -->
		<Compile Remove="NsfwSharp\**\*" />
	</ItemGroup>

	<Target Name="GenerateBackendConfig" BeforeTargets="Build"
	        Inputs="$(ProjectDir)server\server.py;$(ProjectDir)server\server.spec"
	        Outputs="$(BackendProjectDir)\$(BackendExecutable)">
		<Exec Command="&quot;$(VenvPython)&quot; -m PyInstaller --onefile --hidden-import python_multipart --hidden-import onnxruntime --hidden-import onnxruntime.capi._pybind_state --exclude-module torch --exclude-module torchvision --exclude-module torchaudio --exclude-module ultralytics --exclude-module tensorboard --exclude-module matplotlib --exclude-module IPython --exclude-module scipy --exclude-module sklearn --exclude-module pandas --exclude-module nudenet --name server --distpath $(BackendProjectDir) --workpath $(ProjectDir)build --specpath $(BackendProjectDir) server\server.py" WorkingDirectory="$(ProjectDir)" />

		<WriteLinesToFile File="$(BackendProjectDir)\backend.json" Lines="{ &quot;ServerExecutable&quot;: &quot;$(BackendExecutable)&quot; }" Overwrite="true" />

		<Message Text="Generated backend.json with $(BackendExecutable)" Importance="high" />
	</Target>

	<Target Name="GenerateNnBackendConfig" BeforeTargets="Build"
	        Inputs="$(ProjectDir)nn-server\server.py;$(ProjectDir)nn-server\server.spec"
	        Outputs="$(NnBackendProjectDir)\$(NnBackendExecutable)">
		<Exec Command="&quot;$(VenvPython)&quot; -m PyInstaller --onefile --hidden-import python_multipart --hidden-import onnxruntime --hidden-import onnxruntime.capi._pybind_state --hidden-import nudenet --exclude-module torch --exclude-module torchvision --exclude-module torchaudio --exclude-module ultralytics --exclude-module tensorboard --exclude-module matplotlib --exclude-module IPython --exclude-module scipy --exclude-module sklearn --exclude-module pandas --name server --distpath $(NnBackendProjectDir) --workpath $(ProjectDir)build --specpath $(NnBackendProjectDir) nn-server\server.py" WorkingDirectory="$(ProjectDir)" />

		<WriteLinesToFile File="$(NnBackendProjectDir)\backend.json" Lines="{ &quot;ServerExecutable&quot;: &quot;$(NnBackendExecutable)&quot; }" Overwrite="true" />

		<Message Text="Generated nn-server backend.json with $(NnBackendExecutable)" Importance="high" />
	</Target>

	<Target Name="CopyBackendArtifactsToOutput" AfterTargets="Build">
		<!-- Wipe stale backend outputs then copy fresh artifacts -->
		<RemoveDir Directories="$(OutputPath)server" />
		<RemoveDir Directories="$(OutputPath)nn-server" />

		<ItemGroup>
			<BackendArtifacts Include="$(BackendProjectDir)\$(BackendExecutable)" Condition="Exists('$(BackendProjectDir)\$(BackendExecutable)')" />
			<BackendArtifacts Include="$(BackendProjectDir)\*.onnx" />
			<BackendArtifacts Include="$(BackendProjectDir)\backend.json" Condition="Exists('$(BackendProjectDir)\backend.json')" />
			<NnBackendArtifacts Include="$(NnBackendProjectDir)\$(NnBackendExecutable)" Condition="Exists('$(NnBackendProjectDir)\$(NnBackendExecutable)')" />
			<NnBackendArtifacts Include="$(NnBackendProjectDir)\*.onnx" />
			<NnBackendArtifacts Include="$(NnBackendProjectDir)\backend.json" Condition="Exists('$(NnBackendProjectDir)\backend.json')" />
		</ItemGroup>

		<Copy SourceFiles="@(BackendArtifacts)" DestinationFolder="$(OutputPath)server\" />
		<Copy SourceFiles="@(NnBackendArtifacts)" DestinationFolder="$(OutputPath)nn-server\" />
	</Target>

	<Target Name="CopyBackendArtifactsToPublish" AfterTargets="Publish">
		<!-- Wipe stale backend publish output then copy fresh artifacts -->
		<RemoveDir Directories="$(PublishDir)server" />
		<RemoveDir Directories="$(PublishDir)nn-server" />
		<RemoveDir Directories="$(PublishDir)webui" />

		<ItemGroup>
			<BackendArtifactsPublish Include="$(BackendProjectDir)\$(BackendExecutable)" Condition="Exists('$(BackendProjectDir)\$(BackendExecutable)')" />
			<BackendArtifactsPublish Include="$(BackendProjectDir)\*.onnx" />
			<BackendArtifactsPublish Include="$(BackendProjectDir)\backend.json" Condition="Exists('$(BackendProjectDir)\backend.json')" />
			<NnBackendArtifactsPublish Include="$(NnBackendProjectDir)\$(NnBackendExecutable)" Condition="Exists('$(NnBackendProjectDir)\$(NnBackendExecutable)')" />
			<NnBackendArtifactsPublish Include="$(NnBackendProjectDir)\*.onnx" />
			<NnBackendArtifactsPublish Include="$(NnBackendProjectDir)\backend.json" Condition="Exists('$(NnBackendProjectDir)\backend.json')" />
		</ItemGroup>

		<Copy SourceFiles="@(BackendArtifactsPublish)" DestinationFolder="$(PublishDir)server\" />
		<Copy SourceFiles="@(NnBackendArtifactsPublish)" DestinationFolder="$(PublishDir)nn-server\" />

		<ItemGroup>
			<FrontendFilesPublish Include="$(ProjectDir)frontend\dist\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(FrontendFilesPublish)" DestinationFolder="$(PublishDir)webui\%(RecursiveDir)" />
	</Target>

</Project>