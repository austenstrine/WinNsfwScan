<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<PropertyGroup>
		<BackendExecutable Condition="'$(OS)' == 'Windows_NT'">server.exe</BackendExecutable>
		<BackendExecutable Condition="'$(OS)' != 'Windows_NT'">server</BackendExecutable>

		<VenvPython Condition="'$(OS)' == 'Windows_NT'">$(ProjectDir)venv\Scripts\python.exe</VenvPython>
		<VenvPython Condition="'$(OS)' != 'Windows_NT'">$(ProjectDir)venv/bin/python</VenvPython>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="backend.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- ===================================================== -->
	<!--  Automatically build frontend on every dotnet build   -->
	<!-- ===================================================== -->
	<Target Name="BuildFrontend" BeforeTargets="Build">
		<Message Text="=== Building frontend (Vite) ===" Importance="high" />

		<Exec Command="npm run build" WorkingDirectory="$(ProjectDir)frontend" ContinueOnError="false" />

		<!-- Copy dist folder into output directory -->
		<ItemGroup>
			<FrontendFiles Include="$(ProjectDir)frontend\dist\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(OutputPath)webui\%(RecursiveDir)" SkipUnchangedFiles="true" />

		<Message Text="=== Frontend built and copied to webui/ ===" Importance="high" />
	</Target>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
	  <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
	  <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
	  <PackageReference Include="SkiaSharp" Version="3.119.2" />
	</ItemGroup>

	<Target Name="GenerateBackendConfig" BeforeTargets="Build">
		<Exec Command="&quot;$(VenvPython)&quot; -m PyInstaller --onefile --hidden-import python_multipart --name server --distpath $(ProjectDir) --workpath $(ProjectDir)build --specpath $(ProjectDir) server.py" WorkingDirectory="$(ProjectDir)" />

		<WriteLinesToFile File="$(ProjectDir)backend.json" Lines="{ &quot;ServerExecutable&quot;: &quot;$(BackendExecutable)&quot; }" Overwrite="true" />

		<Message Text="Generated backend.json with $(BackendExecutable)" Importance="high" />
	</Target>

</Project>