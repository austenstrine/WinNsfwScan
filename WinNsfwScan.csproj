<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<CsWinRTWindowsMetadata>10.0.19041.0</CsWinRTWindowsMetadata>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<PropertyGroup>
		<BackendExecutable Condition="'$(OS)' == 'Windows_NT'">server.exe</BackendExecutable>
		<BackendExecutable Condition="'$(OS)' != 'Windows_NT'">server</BackendExecutable>
		<BackendProjectDir>$(ProjectDir)server</BackendProjectDir>

		<VenvPython Condition="'$(OS)' == 'Windows_NT'">$(ProjectDir)venv\Scripts\python.exe</VenvPython>
		<VenvPython Condition="'$(OS)' != 'Windows_NT'">$(ProjectDir)venv/bin/python</VenvPython>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="server\backend.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- ===================================================== -->
	<!--  Automatically build frontend on every dotnet build   -->
	<!-- ===================================================== -->
	<Target Name="BuildFrontend" BeforeTargets="Build">
		<Message Text="=== Building frontend (Vite) ===" Importance="high" />

		<Exec Command="npm run build" WorkingDirectory="$(ProjectDir)frontend" ContinueOnError="false" />

		<!-- Copy dist folder into output directory -->
		<ItemGroup>
			<FrontendFiles Include="$(ProjectDir)frontend\dist\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(OutputPath)webui\%(RecursiveDir)" SkipUnchangedFiles="true" />

		<Message Text="=== Frontend built and copied to webui/ ===" Importance="high" />
	</Target>

	<ItemGroup>
		<!-- WebView2 -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />

    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
	</ItemGroup>

	<Target Name="GenerateBackendConfig" BeforeTargets="Build"
	        Inputs="$(ProjectDir)server\server.py;$(ProjectDir)server\server.spec"
	        Outputs="$(BackendProjectDir)\$(BackendExecutable)">
		<Exec Command="&quot;$(VenvPython)&quot; -m PyInstaller --onefile --hidden-import python_multipart --hidden-import onnxruntime --hidden-import onnxruntime.capi._pybind_state --name server --distpath $(BackendProjectDir) --workpath $(ProjectDir)build --specpath $(BackendProjectDir) server\server.py" WorkingDirectory="$(ProjectDir)" />

		<WriteLinesToFile File="$(BackendProjectDir)\backend.json" Lines="{ &quot;ServerExecutable&quot;: &quot;$(BackendExecutable)&quot; }" Overwrite="true" />

		<Message Text="Generated backend.json with $(BackendExecutable)" Importance="high" />
	</Target>

	<Target Name="CopyBackendArtifactsToOutput" AfterTargets="Build">
		<ItemGroup>
			<BackendArtifacts Include="$(BackendProjectDir)\$(BackendExecutable)" Condition="Exists('$(BackendProjectDir)\$(BackendExecutable)')" />
			<BackendArtifacts Include="$(BackendProjectDir)\*.onnx" />
		</ItemGroup>

		<Copy SourceFiles="@(BackendArtifacts)" DestinationFolder="$(OutputPath)server\" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyBackendArtifactsToPublish" AfterTargets="Publish">
		<ItemGroup>
			<BackendArtifactsPublish Include="$(BackendProjectDir)\$(BackendExecutable)" Condition="Exists('$(BackendProjectDir)\$(BackendExecutable)')" />
			<BackendArtifactsPublish Include="$(BackendProjectDir)\*.onnx" />
		</ItemGroup>

		<Copy SourceFiles="@(BackendArtifactsPublish)" DestinationFolder="$(PublishDir)server\" SkipUnchangedFiles="true" />
	</Target>

</Project>